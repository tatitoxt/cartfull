# Public URL of the deployment, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Supabase (Project settings -> API). Locally: `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Use test mode keys until launch.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Only for the end-to-end suite: points the Stripe client at the local stand-in.
# STRIPE_API_BASE=http://127.0.0.1:12111

# Google sign-in button. The provider itself is configured in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH=false

# PostHog (optional). Leave empty to turn analytics off.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
