# Public URL of the deployment, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Supabase (Project settings -> API). Locally: `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Polar (polar.sh) — organization access token, product ids and webhook secret.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_MONTHLY=
POLAR_PRODUCT_ANNUAL=
# Optional: discount id for the first-month offer, and "sandbox" while testing.
# POLAR_DISCOUNT_FIRST_MONTH=
# POLAR_ENVIRONMENT=sandbox
# Only for the end-to-end suite: points the Polar client at the local stand-in.
# POLAR_API_BASE=http://127.0.0.1:12111

# Google sign-in button. The provider itself is configured in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH=false

# PostHog (optional). Leave empty to turn analytics off.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
